// Particle-shape contacts: Newton's create_soft_contacts for analytic shapes, over every particle × shape pair.
#pragma kernel ClearCount
#pragma kernel CreateSoftContacts

#include "Transform.hlsl"

#define PARTICLE_ACTIVE 1
#define COLLIDE_PARTICLES 4
#define GEO_PLANE 1
#define GEO_SPHERE 3
#define GEO_CAPSULE 4
#define GEO_BOX 7

StructuredBuffer<float3> _ParticleQ;
StructuredBuffer<float> _ParticleRadius;
StructuredBuffer<int> _ParticleFlags;
StructuredBuffer<Xform> _BodyQ;
StructuredBuffer<int> _ShapeBody;
StructuredBuffer<Xform> _ShapeTransform;
StructuredBuffer<int> _ShapeType;
StructuredBuffer<float3> _ShapeScale;
StructuredBuffer<int> _ShapeFlags;
StructuredBuffer<float> _ShapeMargin;

RWStructuredBuffer<uint> _ContactCount;
RWStructuredBuffer<int> _ContactParticle;
RWStructuredBuffer<int> _ContactShape;
RWStructuredBuffer<float3> _ContactBodyPos;
RWStructuredBuffer<float3> _ContactBodyVel;
RWStructuredBuffer<float3> _ContactNormal;

int _ParticleCount;
int _ShapeCount;
int _ContactMax;
float _Gap;

[numthreads(1, 1, 1)]
void ClearCount() { _ContactCount[0] = 0; }

float SdfBox(float3 p, float3 h)
{
    float3 q = abs(p) - h;
    return length(max(q, 0.0)) + min(max(q.x, max(q.y, q.z)), 0.0);
}

float3 SdfBoxGrad(float3 p, float3 h)
{
    float3 q = abs(p) - h;
    if (q.x > 0.0 || q.y > 0.0 || q.z > 0.0) return normalize(p - clamp(p, -h, h));
    float3 s = sign(p);
    if ((q.x > q.y && q.x > q.z) || (q.y == 0.0 && q.z == 0.0)) return float3(s.x, 0, 0);
    if ((q.y > q.x && q.y > q.z) || (q.x == 0.0 && q.z == 0.0)) return float3(0, s.y, 0);
    return float3(0, 0, s.z);
}

// Capsule along local z; v is the point relative to the nearest point of the axis segment.
float3 CapsuleOffset(float3 p, float halfHeight)
{
    return float3(p.x, p.y, p.z - clamp(p.z, -halfHeight, halfHeight));
}

float3 SafeNormal(float3 v, float3 fallback)
{
    float l = length(v);
    return l > 1e-8 ? v / l : fallback;
}

[numthreads(64, 1, 1)]
void CreateSoftContacts(uint3 id : SV_DispatchThreadID)
{
    uint tid = id.x;
    if (tid >= (uint)(_ParticleCount * _ShapeCount)) return;
    int particle = (int)(tid / (uint)_ShapeCount);
    int shape = (int)tid - particle * _ShapeCount;
    if ((_ParticleFlags[particle] & PARTICLE_ACTIVE) == 0 || (_ShapeFlags[shape] & COLLIDE_PARTICLES) == 0) return;

    int body = _ShapeBody[shape];
    Xform bodyX = XformIdentity();
    if (body >= 0) bodyX = _BodyQ[body];
    Xform shapeX = _ShapeTransform[shape];
    Xform worldX = XformMul(bodyX, shapeX);
    float3 x = XformPoint(XformInverse(worldX), _ParticleQ[particle]);
    float3 scale = _ShapeScale[shape];
    int type = _ShapeType[shape];

    float d = 1.0e6;
    float3 n = 0;
    if (type == GEO_SPHERE)
    {
        d = length(x) - scale.x;
        n = SafeNormal(x, float3(0, 0, 1));
    }
    else if (type == GEO_BOX)
    {
        d = SdfBox(x, scale);
        n = SdfBoxGrad(x, scale);
    }
    else if (type == GEO_CAPSULE)
    {
        float3 v = CapsuleOffset(x, scale.y);
        d = length(v) - scale.x;
        n = SafeNormal(v, x.z > scale.y ? float3(0, 0, 1) : x.z < -scale.y ? float3(0, 0, -1) : float3(0, 0, 1));
    }
    else if (type == GEO_PLANE)
    {
        float hw = scale.x * 0.5, hl = scale.y * 0.5;
        d = hw > 0.0 && hl > 0.0 ? max(max(abs(x.x) - hw, abs(x.y) - hl), abs(x.z)) : x.z;
        n = float3(0, 0, 1);
    }

    if (d >= _Gap + _ShapeMargin[shape] + _ParticleRadius[particle]) return;
    uint index;
    InterlockedAdd(_ContactCount[0], 1, index);
    if ((int)index >= _ContactMax) return;
    // Closest surface point in the body frame; the shape margin is applied at force evaluation.
    _ContactParticle[index] = particle;
    _ContactShape[index] = shape;
    _ContactBodyPos[index] = XformPoint(shapeX, x - n * d);
    _ContactBodyVel[index] = 0;
    _ContactNormal[index] = XformVector(worldX, n);
}
